# Sanity — אותו פרויקט/dataset של האתר הקיים
# חובה להגדיר את שני אלה ב-Vercel (Project Settings → Environment Variables),
# אחרת האתר לא יוכל למשוך תוכן מ-Sanity ויופיע ריק.
PUBLIC_SANITY_PROJECT_ID=bk4y5jiw
PUBLIC_SANITY_DATASET=production

# /api/upload-asset — העלאת תמונות אוטומטית ל-Sanity (לא לשימוש גולשים).
# SANITY_WRITE_TOKEN: טוקן פרטי עם הרשאת כתיבה, נוצר ב-manage.sanity.io →
# הפרויקט → API → Tokens → Add API token (הרשאה Editor ומעלה). אף פעם לא
# PUBLIC_*, ואף פעם לא אותו טוקן ששומשים אחרים בו.
# UPLOAD_API_SECRET: סוד משותף כלשהו (למשל 32 בייט אקראיים) ששומר את
# הנקודה מפני שימוש ציבורי — כל בקשה חייבת לשאת אותו ב-Authorization: Bearer.
SANITY_WRITE_TOKEN=
UPLOAD_API_SECRET=
