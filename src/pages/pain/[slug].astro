---
import PainPage from '../../components/PainPage.astro'
import {sanity} from '../../lib/sanity'
import {PAIN_BY_SLUG_QUERY} from '../../lib/sanityQueries'
import site from '../../content/pages/site.json'
const {slug} = Astro.params
const pain = await sanity.fetch(PAIN_BY_SLUG_QUERY, {slug})
if (!pain) return new Response('Not found', {status: 404})
const english = await sanity.fetch(`*[_type == "page" && slug.current == $slug && coalesce(seo.noindex, false) == false][0]{_id}`, {slug: `en/pain/${slug}`})
const languageLinks = english ? [{language:'he',href:`${site.siteUrl}/pain/${slug}`},{language:'en',href:`${site.siteUrl}/en/pain/${slug}`}] : []
---
<PainPage pain={pain} slug={slug} languageLinks={languageLinks} />
