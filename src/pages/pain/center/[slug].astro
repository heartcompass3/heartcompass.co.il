---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../../components/Breadcrumbs.astro'
import site from '../../../content/pages/site.json'
import { sanity } from '../../../lib/sanity'
import { optImg } from '../../../lib/img'
import { INFO_CENTERS, articleMatchesCenter } from '../../../lib/infoCenters'

const center = INFO_CENTERS.find((item) => item.slug === Astro.params.slug)
if (!center) return new Response('Not found', { status: 404 })

const articles = (await sanity.fetch(`*[_type == "article"] | order(coalesce(publishedAt, _createdAt) desc){title, slug, excerpt, publishedAt, tags, painTags, mainImage{alt, asset->{url}}}`))
  .filter((article: any) => articleMatchesCenter(article, center))

const title = `${center.title} | מרכז המידע | ${site.brand}`
const description = center.description
const canonical = new URL(Astro.url.pathname, site.siteUrl).toString()
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: center.title,
  description,
  inLanguage: 'he',
  isPartOf: { '@id': `${site.siteUrl}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.map((article: any, index: number) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: `${site.siteUrl}/articles/${article.slug?.current || article.slug}`,
    })),
  },
}
const formatDate = (value?: string) => value ? new Date(value).toLocaleDateString('he-IL') : ''
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[schema]}>
  <section class="animate-fade-in py-24 bg-background min-h-screen">
    <div class="max-w-6xl mx-auto px-6">
      <Breadcrumbs items={[{ name: 'מרכז המידע', href: '/pain' }, { name: center.title }]} />
      <header class="max-w-4xl mx-auto text-center mb-14">
        <p class="text-accent font-bold font-body mb-3">{center.eyebrow}</p>
        <h1 class="text-4xl md:text-6xl font-black text-primary font-display mb-6">{center.title}</h1>
        <p class="text-xl text-primary/70 font-body leading-relaxed">{center.description}</p>
      </header>

      <div class="max-w-4xl mx-auto bg-white rounded-[2rem] border border-primary/10 p-7 md:p-10 mb-14 text-center shadow-sm">
        <h2 class="text-2xl md:text-3xl font-black text-primary font-display mb-3">לא רק לדעת מה קורה — להתחיל לראות מה מנהל</h2>
        <p class="text-primary/70 font-body leading-relaxed">המאמרים במרכז הזה עוזרים לזהות את הרגע החי, את המשמעות שמתחתיו ואת הצעד האפשרי מתוך בחירה ולא מתוך פחד.</p>
      </div>

      <section aria-labelledby="center-articles-title">
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 id="center-articles-title" class="text-3xl md:text-4xl font-black text-primary font-display">מאמרים בנושא</h2>
          <span class="text-primary/45 font-body text-sm">{articles.length} מאמרים</span>
        </div>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((article: any) => (
            <a href={`/articles/${article.slug?.current || article.slug}`} class="group bg-white rounded-[2rem] border border-primary/10 overflow-hidden shadow-sm hover:-translate-y-1 hover:shadow-xl transition-all">
              <div class="h-44 bg-primary/5 overflow-hidden">
                <img src={optImg(article.mainImage?.asset?.url, 600) || '/assets/yossi-hero.jpg'} alt={article.mainImage?.alt || article.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
              </div>
              <div class="p-6 text-right">
                {article.publishedAt && <p class="text-xs text-primary/45 font-body mb-2">{formatDate(article.publishedAt)}</p>}
                <h3 class="text-xl font-black text-primary font-display leading-snug group-hover:text-gold-dark transition-colors">{article.title}</h3>
                {article.excerpt && <p class="mt-3 text-primary/65 font-body leading-relaxed line-clamp-3">{article.excerpt}</p>}
              </div>
            </a>
          ))}
        </div>
      </section>

      <div class="max-w-3xl mx-auto mt-16 rounded-[2rem] bg-primary text-white p-8 md:p-10 text-center">
        <h2 class="text-2xl md:text-3xl font-black font-display mb-3">רוצים להבין מה הצעד הבא?</h2>
        <p class="text-white/75 font-body leading-relaxed mb-6">אפשר להתחיל בשיחה קצרה ולבדוק אם {center.serviceLabel} מתאים לכם.</p>
        <a href={center.serviceHref} class="inline-flex rounded-full bg-white text-primary px-6 py-3 font-body font-bold hover:bg-accent hover:text-white transition">{center.serviceLabel}</a>
      </div>
    </div>
  </section>
</BaseLayout>
