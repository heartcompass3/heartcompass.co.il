---
import BaseLayout from '../../layouts/BaseLayout.astro'
---
<BaseLayout title="Thank you for subscribing | Heart Compass" description="Your newsletter registration is complete." language="en" noIndex={true}>
  <section class="max-w-2xl mx-auto px-6 py-24 text-center">
    <h1 class="text-4xl font-display text-primary font-bold">Thank you for subscribing</h1>
    <p class="mt-6 text-lg leading-relaxed">You are on the list. I will share insights on the patterns, fears, and choices that shape everyday life.</p>
    <p class="mt-4 text-muted-foreground">You can unsubscribe at any time using the link in each email.</p>
    <a href="/en" class="inline-block mt-8 rounded-xl bg-primary text-white px-6 py-3">Back to Heart Compass</a>
  </section>
</BaseLayout>
