---
import '../../styles/global.css'
import site from '../../content/pages/site.json'

// Isolated English pilot. No language switcher or changes to Hebrew routes.
// Keep the page out of search results until the translation and navigation are approved.
import { createClient } from '@sanity/client'
import { sanity } from '../../lib/sanity'

// Preview branch reads the Sanity draft on the server. Never expose its token to the browser.
const preview = import.meta.env.VERCEL_ENV !== 'production'
const draftClient = preview && process.env.SANITY_AUTH_TOKEN
  ? sanity.withConfig({ token: process.env.SANITY_AUTH_TOKEN, useCdn: false, perspective: 'drafts' })
  : null
const page = await (draftClient ?? sanity).fetch(`*[_type == "page" && slug.current == "en/about"][0]{title,excerpt,body,seo}`)
const title = page?.seo?.title || 'About Yossi Medalsi | Heart Compass'
const description = page?.seo?.description || 'Emotional coaching with Yossi Medalsi, founder of Heart Compass.'
const paragraphs = (page?.body || []).map((block: any) => ({
  style: block.style,
  text: (block.children || []).map((child: any) => child.text || '').join('')
})).filter((item: any) => item.text.trim())
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-background text-foreground" style="font-family: Assistant, sans-serif">
    <header class="border-b border-foreground/10 bg-white/80">
      <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-5" aria-label="Main navigation">
        <a href="/en/about" class="text-xl font-extrabold text-primary">Heart Compass</a>
        <a href="/about" class="text-sm font-semibold text-primary underline underline-offset-4" lang="he" dir="rtl">עברית</a>
      </nav>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-6 py-14 md:py-24">
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <p class="mb-4 text-sm font-bold uppercase tracking-widest text-accent">About Heart Compass</p>
          <h1 class="mb-7 text-4xl font-extrabold leading-tight text-primary md:text-6xl">Meet Yossi Medalsi</h1>
          <p class="mb-6 text-xl font-semibold leading-relaxed text-primary">{page?.excerpt || 'Emotional coaching for a life with more choice and confidence.'}</p>
          {paragraphs.slice(0,3).map((p: any) => <p class="mb-5 text-lg leading-relaxed">{p.text}</p>)}
          <a href={`https://wa.me/${site.whatsAppPhone}`} class="inline-flex min-h-12 items-center justify-center rounded-xl bg-primary px-7 py-3 font-bold text-white hover:opacity-90">Let's talk on WhatsApp</a>
        </div>
        <div class="mx-auto w-full max-w-md overflow-hidden rounded-3xl border-8 border-white shadow-xl">
          <img src="/assets/yossi-about.jpg" alt="Yossi Medalsi, founder of Heart Compass" width="800" height="1000" class="h-auto w-full object-cover" />
        </div>
      </div>
      <section class="mt-16 rounded-3xl bg-white/70 p-8 md:p-12">
        {paragraphs.slice(3).map((p: any) => p.style === 'h2'
          ? <h2 class="mb-5 mt-8 text-3xl font-extrabold text-primary">{p.text}</h2>
          : <p class="mb-5 text-lg leading-relaxed">{p.text}</p>)}
      </section>
    </main>
    <footer class="border-t border-foreground/10 px-6 py-8 text-center text-sm text-foreground/70">
      <p>Heart Compass · Yossi Medalsi</p>
      <a href="/about" class="mt-2 inline-block underline underline-offset-4">Read the Hebrew about page</a>
    </footer>
  </body>
</html>
