---
import EnglishPage from '../../components/EnglishPage.astro'
import AboutPage from '../../components/AboutPage.astro'
import site from '../../content/pages/site.json'

// One Sanity-driven template for all English pages. New pages need no new Astro route.
import { sanity } from '../../lib/sanity'

// Preview branch reads the Sanity draft on the server. Never expose its token to the browser.
const preview = import.meta.env.VERCEL_ENV !== 'production'
const draftClient = preview && process.env.SANITY_AUTH_TOKEN
  ? sanity.withConfig({ token: process.env.SANITY_AUTH_TOKEN, useCdn: false, perspective: 'drafts' })
  : null
const slug = (Astro.params.slug || '').split('/').filter(Boolean).join('/')
if (!slug || !/^[a-z0-9]+(?:[a-z0-9/-]*[a-z0-9])?$/.test(slug)) return Astro.redirect('/404', 302)
const page = await (draftClient ?? sanity).fetch(`*[_type == "page" && slug.current == $slug][0]{title,excerpt,body,seo,aiCitation,aiContext,painTags,specialty{practicalGuidance,faqTitle,faq[]{question,answer},closing}}`, { slug: `en/${slug}` })
if (!page) return Astro.redirect('/404', 302)
const isAbout = slug === 'about'
const hebrewAbout = isAbout ? await sanity.fetch(`*[_type == "page" && slug.current == "about" && coalesce(seo.noindex, false) == false][0]{_id}`) : null
const languageLinks = hebrewAbout && !page?.seo?.noindex ? [
  {language: 'he', href: `${site.siteUrl}/about`},
  {language: 'en', href: `${site.siteUrl}/en/about`},
] : []
---
{isAbout ? <AboutPage page={page} language="en" languageLinks={languageLinks} /> : <EnglishPage page={page} slug={slug} />}
