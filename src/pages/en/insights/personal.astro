---
import PersonalKnowledgeLibrary from '../../../components/PersonalKnowledgeLibrary.astro'
import {sanity} from '../../../lib/sanity'
import {LIBRARY_PAGE_QUERY, LIBRARY_ARTICLES_QUERY} from '../../../lib/knowledgeLibrary.mjs'
const [page, original, articles] = await Promise.all([
  sanity.fetch(LIBRARY_PAGE_QUERY, {slug:'en/insights/personal'}),
  sanity.fetch(LIBRARY_PAGE_QUERY, {slug:'insights/personal'}),
  sanity.fetch(LIBRARY_ARTICLES_QUERY, {language:'en'}),
])
if (!page) return new Response('Not found', {status:404})
---
<PersonalKnowledgeLibrary page={page} articles={articles} language="en" hasCounterpart={!!original} />
