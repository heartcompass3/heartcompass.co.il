---
import EnglishContentPage from '../../../components/EnglishContentPage.astro'
import { sanity } from '../../../lib/sanity'
const page = await sanity.fetch(`*[_type == "page" && slug.current == "en/specialties/couples"][0]{title,excerpt,body,specialty,seo,aiCitation,aiContext,painTags}`)
if (!page) return new Response('Not found', {status: 404})
---
<EnglishContentPage page={page} hebrewPath="/specialties/couples" />
