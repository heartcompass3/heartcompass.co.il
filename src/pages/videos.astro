---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { buildWhatsAppHref } from '../lib/whatsapp'
import site from '../content/pages/site.json'

const channelId = 'UCo3tMRDrFY_zUlgeJXyvxjQ'
const videoWhatsAppHref = buildWhatsAppHref(
  site.whatsAppPhone,
  'היי יוסי, הגעתי דרך עמוד הווידאו. צפיתי בסרטון ורוצה לשאול על משהו שנגע בי או קרה אצלנו בבית.',
)

const fallbackVideos = [
  { id: 'C3tFtybKkR0', title: 'איך "שכחת שוב" הופך בסוף ל"ככה אתה"?', published: '2026-08-31' },
  { id: '3-ttg8m03fk', title: 'למה מתבגרים משקרים להורים, גם כשהם יודעים שהשקר עלול לפגוע באמון?', published: '2026-08-20' },
]

const decodeXml = (value = '') => value
  .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1')
  .replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&#39;|&apos;/g, "'")
  .replace(/&lt;/g, '<').replace(/&gt;/g, '>').trim()

const readTag = (entry, name) => {
  const match = entry.match(new RegExp(`<${name}[^>]*>([\\s\\S]*?)</${name}>`))
  return match ? decodeXml(match[1]) : ''
}

let videos = fallbackVideos
try {
  const response = await fetch(`https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}`)
  if (response.ok) {
    const xml = await response.text()
    const fetched = [...xml.matchAll(/<entry>([\s\S]*?)<\/entry>/g)]
      .slice(0, 6)
      .map((match) => ({
        id: readTag(match[1], 'yt:videoId'),
        title: readTag(match[1], 'title'),
        published: readTag(match[1], 'published'),
      }))
      .filter((video) => video.id && video.title)
    if (fetched.length) videos = fetched
  }
} catch {
  // Keep the page useful when the build server cannot reach YouTube.
}

const title = `וידאו | ${site.brand}`
const description = 'סרטונים של יוסי מדלסי על הורות, מתבגרים, פחדים, דפוסים ובחירה מתוך מצפן הלב.'

const videoSchemas = videos.map((video) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description: video.title,
  thumbnailUrl: `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`,
  uploadDate: video.published || undefined,
  embedUrl: `https://www.youtube.com/embed/${video.id}`,
  contentUrl: `https://www.youtube.com/watch?v=${video.id}`,
  publisher: {
    '@type': 'Organization',
    name: site.brand,
    url: site.siteUrl,
  },
}))
---

<BaseLayout title={title} description={description} schema={videoSchemas}>
  <section class="animate-fade-in py-24 bg-background min-h-screen">
    <div class="max-w-7xl mx-auto px-6">
      <Breadcrumbs items={[{ name: 'וידאו' }]} />
      <header class="max-w-3xl mx-auto text-center mb-14">
        <p class="text-accent font-bold font-body mb-4">מצפן הלב ביוטיוב</p>
        <h1 class="text-5xl md:text-6xl font-black text-primary font-display mb-6">וידאו</h1>
        <p class="text-xl md:text-2xl text-primary/70 font-body font-medium leading-relaxed">
          רגעים קצרים למחשבה על הורות, מתבגרים, פחדים ודפוסים — ומה אפשר לבחור אחרת בתוך החיים עצמם.
        </p>
        <a href={site.youtubeUrl} target="_blank" rel="noopener noreferrer" class="inline-flex mt-8 items-center gap-2 rounded-full bg-primary px-6 py-3 text-white font-body font-bold hover:bg-accent transition">
          לכל הסרטונים בערוץ YouTube <span aria-hidden="true">←</span>
        </a>
      </header>

      <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
        {videos.map((video) => (
          <article class="overflow-hidden rounded-[2rem] bg-white border border-primary/10 shadow-lg hover:-translate-y-1 transition-transform">
            <div class="aspect-video bg-primary/5" data-video-shell>
              <button
                type="button"
                class="relative w-full h-full bg-cover bg-center group"
                style={`background-image: linear-gradient(rgba(15,44,54,.2), rgba(15,44,54,.45)), url(https://i.ytimg.com/vi/${video.id}/hqdefault.jpg)`}
                data-video-id={video.id}
                aria-label={`הפעלת הסרטון: ${video.title}`}
              >
                <span class="absolute inset-0 flex items-center justify-center">
                  <span class="flex items-center justify-center w-16 h-16 rounded-full bg-accent text-primary text-2xl shadow-xl transition-transform group-hover:scale-110" aria-hidden="true">▶</span>
                </span>
              </button>
            </div>
            <div class="p-6 text-right">
              <p class="text-xs text-primary/45 font-body mb-2">{video.published ? new Date(video.published).toLocaleDateString('he-IL') : ''}</p>
              <h2 class="text-xl font-black text-primary font-display leading-snug">{video.title}</h2>
            </div>
          </article>
        ))}
      </div>

      <section class="max-w-5xl mx-auto mt-16" aria-labelledby="video-paths-title">
        <div class="text-center mb-8">
          <p class="text-accent font-bold font-body mb-2">לאן ממשיכים מכאן?</p>
          <h2 id="video-paths-title" class="text-3xl md:text-4xl font-black text-primary font-display">בחרו את הנושא שהכי קרוב אליכם</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <a href="/specialties/parents" class="rounded-2xl border border-primary/10 bg-white p-6 text-right hover:-translate-y-1 hover:border-accent/50 transition">
            <h3 class="text-xl font-black text-primary font-display mb-2">הדרכת הורים</h3>
            <p class="text-primary/65 font-body leading-relaxed">כשהבית מלא מתח, וצריך להבין מה קורה מתחת להתנהגות.</p>
          </a>
          <a href="/specialties/youth" class="rounded-2xl border border-primary/10 bg-white p-6 text-right hover:-translate-y-1 hover:border-accent/50 transition">
            <h3 class="text-xl font-black text-primary font-display mb-2">ליווי בני נוער</h3>
            <p class="text-primary/65 font-body leading-relaxed">להחזיר תחושת ערך, בחירה ויכולת לנוע מתוך עצמם.</p>
          </a>
          <a href="/specialties/personal" class="rounded-2xl border border-primary/10 bg-white p-6 text-right hover:-translate-y-1 hover:border-accent/50 transition">
            <h3 class="text-xl font-black text-primary font-display mb-2">תהליך אישי</h3>
            <p class="text-primary/65 font-body leading-relaxed">לזהות דפוסים שחוזרים ולבחור פעולה חדשה שמתאימה לכם.</p>
          </a>
        </div>
      </section>

      <div class="max-w-3xl mx-auto mt-16 rounded-[2rem] bg-primary text-white p-8 md:p-10 text-center">
        <h2 class="text-2xl md:text-3xl font-black font-display mb-3">סרטון נגע במשהו שקורה אצלכם בבית?</h2>
        <p class="text-white/75 font-body leading-relaxed mb-6">אפשר להתחיל בשיחה פשוטה, בלי להתחייב ובלי לדעת מראש את כל התשובות.</p>
        <a href={videoWhatsAppHref} data-track-event="whatsapp_click" data-track-label="videos" class="inline-flex rounded-full bg-white text-primary px-6 py-3 font-body font-bold hover:bg-accent hover:text-white transition">לדבר עם יוסי</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-video-shell] button[data-video-id]').forEach((button) => {
    button.addEventListener('click', () => {
      const videoId = button.dataset.videoId;
      if (!videoId) return;

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${encodeURIComponent(videoId)}?autoplay=1`;
      iframe.title = button.getAttribute('aria-label') || 'סרטון YouTube';
      iframe.loading = 'eager';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'w-full h-full border-0';
      button.replaceWith(iframe);
    });
  });
</script>
