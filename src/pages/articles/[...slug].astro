---
import ArticlePage from "../../components/ArticlePage.astro"
import { sanity } from "../../lib/sanity"
import { ARTICLE_BY_SLUG_QUERY } from "../../lib/sanityQueries"
const rawSlug = Astro.params.slug
const joinedSlug = Array.isArray(rawSlug) ? rawSlug.join('/') : (rawSlug || '')

// נרמול הסלאג: גיזום רווחים מובילים/עוקבים והסרת סלאש מוביל. כתובות "מלוכלכות"
// ישנות שנשארו בזיכרון של גוגל (למשל "/articles/ addiction-root-cause-healing"
// עם רווח מוביל מתקופת ה-bulk upload) מקבלות 301 נקי לכתובת הקנונית — במקום
// redirect רך של 302 ל-/articles שגורם ל"נסרק ולא אונדקס".
const slug = joinedSlug.trim().replace(/^\/+/, '')

if (slug && slug !== joinedSlug) {
  return Astro.redirect(encodeURI(`/articles/${slug}`), 301)
}

// הפניות 301 מ-slugs ישנים (שתוקנו לאנגלית נקייה) — שומר על קישורים/אינדוקס קיימים.
const OLD_SLUG_REDIRECTS: Record<string, string> = {
  'teen-diagnosis-does-it-mean-something-is-wrong-with-me': 'adhd-diagnosis-for-teens-does-it-mean-something-is-wrong-with-me',
  'מתקיעות לתנועה': 'stop-repeating-the-script',
  'דיכאון, תקיעות ואנרגיה': 'hidden-cost-of-hypervigilance',
  'automating-the-soul-future-of-': 'automating-the-soul-future-of',
  'teen-diagnosis-does-it-mean-something-is-wrong-with-me': 'adhd-diagnosis-for-teens-does-it-mean-something-is-wrong-with-me',
  'midlife-crisis-in-men': 'midlife-crisis-external-escapes-psychology',
}

const article = await sanity.fetch(ARTICLE_BY_SLUG_QUERY, { slug, language: "he" })

if (!article) {
  if (slug && OLD_SLUG_REDIRECTS[slug]) {
    return Astro.redirect(`/articles/${OLD_SLUG_REDIRECTS[slug]}`, 301)
  }
  return Astro.redirect('/articles', 302)
}

---
<ArticlePage article={article} slug={slug} language="he" />
