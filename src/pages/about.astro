---
import AboutPage from '../components/AboutPage.astro'
import { ABOUT_QUERY } from '../lib/aboutQuery'
import { sanity } from '../lib/sanity'
import site from '../content/pages/site.json'
const [page, englishPage] = await Promise.all([
  sanity.fetch(ABOUT_QUERY),
  sanity.fetch(`*[_type == "page" && slug.current == "en/about" && coalesce(seo.noindex, false) == false][0]{_id}`),
])
const languageLinks = englishPage ? [
  {language: 'he', href: `${site.siteUrl}/about`},
  {language: 'en', href: `${site.siteUrl}/en/about`},
] : []
---
<AboutPage page={page} language="he" languageLinks={languageLinks} />
