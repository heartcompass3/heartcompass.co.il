---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import site from '../../content/pages/site.json'
import { sanity } from '../../lib/sanity'
import { buildBreadcrumbListSchema } from '../../lib/breadcrumbs'
import { buildWhatsAppHref } from '../../lib/whatsapp'

const page = await sanity.fetch(`*[_type == "landingPage" && slug.current == "parent-moment-tool"][0]{title,subtitle,seoDescription,interactiveTool{eyebrow,firstQuestion,firstOptions[]{_key,key,label},secondQuestion,secondOptions[]{_key,key,label},results[]{_key,key,title,text,nextStep,phrase},safetyTitle,safetyText}}`)
const fallback = {
  eyebrow: 'כלי קצר להורים', firstQuestion: 'מה קורה אצלכם ברגע הזה?',
  firstOptions: [{key:'short-answer',label:'אני שואל/ת איך היה, ומקבל/ת רק „בסדר”'},{key:'closed-door',label:'הוא או היא נכנסים לחדר וסוגרים את הדלת'},{key:'argument',label:'שיחה פשוטה הופכת מהר לוויכוח או להתפרצות'}],
  secondQuestion: 'מה הדחף הראשון שלך כהורה?',
  secondOptions: [{key:'ask-more',label:'לשאול עוד, כדי להבין מה קרה'},{key:'solve',label:'להציע פתרון, כדי להקל עליו או עליה'},{key:'set-boundary',label:'להציב גבול מיד, כדי לעצור את מה שקורה'}],
  results: [
    {key:'ask-more',title:'הרצון להבין הוא טבעי. לפעמים הוא נשמע כמו לחץ.',text:'כשאנחנו דואגים, השאלות באות מהר. המתבגר עלול לשמוע בהן חקירה, גם כשהכוונה היא קרבה.',nextStep:'בפעם הבאה, עצרו אחרי שאלה אחת. אמרו שאתם זמינים, ותנו לו או לה לבחור אם ומתי להמשיך.',phrase:'„אני רואה שלא מתאים לדבר עכשיו. אני כאן כשתרצה/י.”'},
    {key:'solve',title:'הרצון לפתור הוא אהבה בפעולה. קודם צריך מקום.',text:'פתרון מהיר יכול להישמע למתבגר כאילו לא הקשיבו למה שהוא מרגיש, או כאילו הוא לא מסוגל להתמודד בעצמו.',nextStep:'לפני עצה, בקשו רשות: האם מתאים לשמוע רעיון, או שכרגע צריך רק לפרוק?',phrase:'„רוצה שאחשוב איתך על פתרון, או שעדיף שאהיה רגע איתך בזה?”'},
    {key:'set-boundary',title:'גבול חשוב, אבל הוא עובד טוב יותר אחרי שמזהים את הרגע.',text:'גבול שנאמר בזמן הצפה עלול להפוך לעוד מאבק. אפשר לשמור על הגבול, ובכל זאת להוריד את העוצמה של השיחה.',nextStep:'נסחו את הגבול בקצרה, ואז דחו את השיחה המלאה לזמן שבו אפשר להקשיב בלי להילחם.',phrase:'„אני לא מסכים/ה שידברו אליי ככה. נעצור עכשיו ונחזור לזה כשנוכל לדבר אחרת.”'},
  ],
  safetyTitle:'חשוב לדעת', safetyText:'הכלי נועד לעזור לעצור ולבחור תגובה אחת אחרת בבית. הוא אינו אבחון ואינו תחליף למענה מקצועי. אם יש חשש לפגיעה עצמית, אלימות, שימוש בחומרים או שינוי חד ומתמשך בתפקוד — חשוב לפנות בהקדם לאיש או אשת מקצוע בתחום בריאות הנפש או לרופא/ת המשפחה.',
}
const tool = page?.interactiveTool || fallback
const title = page?.title || 'מפת הרגע בבית'
const description = page?.seoDescription || page?.subtitle || 'כלי קצר להורים שעוזר לעצור ברגע של ריחוק או ויכוח עם מתבגר, ולבחור תגובה אחת אחרת.'
const canonical = new URL(Astro.url.pathname, site.siteUrl).toString()
const whatsappHref = buildWhatsAppHref(site.whatsAppPhone, 'היי יוסי, השתמשתי במפת הרגע בבית. אני רוצה להבין איך אפשר להגיב אחרת ברגעים של ריחוק או ויכוח עם המתבגר/ת שלי.')
const breadcrumbSchema = buildBreadcrumbListSchema({siteUrl:site.siteUrl,brandName:site.brand,crumbs:[{name:'כלים ומדריכים',item:`${site.siteUrl}/tools`},{name:title,item:canonical}]})
---
<BaseLayout title={`${title} | ${site.brand}`} description={description} canonical={canonical} schema={[breadcrumbSchema]}>
  <section class="animate-fade-in py-16 md:py-24 bg-background min-h-screen"><div class="max-w-3xl mx-auto px-6">
    <Breadcrumbs withSchema={false} items={[{ name: 'כלים ומדריכים', href: '/tools' }, { name: title }]} />
    <header class="text-center mb-10 md:mb-14"><p class="text-accent font-display font-black text-sm tracking-wide mb-4">{tool.eyebrow}</p><h1 class="text-4xl md:text-6xl font-black text-primary font-display mb-6">{title}</h1><p class="text-xl text-primary/75 font-body leading-relaxed max-w-2xl mx-auto">{page?.subtitle || 'שתי בחירות קצרות שיעזרו לך להבין מה קורה אצלך ברגע שהשיחה בבית מתחילה להיסגר — ולבחור צעד קטן אחר.'}</p></header>
    <div class="bg-white rounded-[2.5rem] shadow-elegant border border-primary/10 p-6 md:p-10" data-parent-moment-tool>
      <div class="flex items-center gap-3 mb-9" aria-label="התקדמות בכלי"><span class="w-8 h-8 rounded-full bg-accent text-primary font-black flex items-center justify-center" data-step-number>1</span><div class="h-2 flex-1 rounded-full bg-primary/10 overflow-hidden" aria-hidden="true"><div class="h-full bg-accent transition-all duration-300" style="width:50%" data-progress></div></div><span class="text-sm text-primary/60 font-body" data-step-label>שלב 1 מתוך 2</span></div>
      <form data-tool-form><fieldset data-question="first"><legend class="text-2xl md:text-3xl font-black text-primary font-display mb-6">{tool.firstQuestion}</legend><div class="grid gap-3">{tool.firstOptions.map((option) => <button type="button" class="tool-choice text-right rounded-2xl border border-primary/15 p-5 font-body font-bold text-primary transition hover:border-accent hover:bg-accent/10 focus:outline-none focus:ring-2 focus:ring-accent" data-first-option={option.key}>{option.label}</button>)}</div></fieldset>
      <fieldset data-question="second" class="hidden" aria-live="polite"><legend class="text-2xl md:text-3xl font-black text-primary font-display mb-6">{tool.secondQuestion}</legend><div class="grid gap-3">{tool.secondOptions.map((option) => <button type="button" class="tool-choice text-right rounded-2xl border border-primary/15 p-5 font-body font-bold text-primary transition hover:border-accent hover:bg-accent/10 focus:outline-none focus:ring-2 focus:ring-accent" data-second-option={option.key}>{option.label}</button>)}</div><button type="button" class="mt-6 text-primary/65 underline font-body" data-back>חזרה לשאלה הקודמת</button></fieldset></form>
      <section data-result class="hidden" tabindex="-1" aria-live="polite"><p class="text-accent font-display font-black text-sm tracking-wide mb-3">מה אפשר לנסות בפעם הבאה</p><h2 class="text-3xl font-black text-primary font-display mb-5" data-result-title></h2><p class="text-primary/80 font-body leading-relaxed text-lg mb-7" data-result-text></p><div class="rounded-2xl bg-background p-6 border border-primary/10 mb-5"><h3 class="font-black text-primary text-lg mb-2">צעד אחד קטן</h3><p class="text-primary/75 font-body leading-relaxed" data-result-step></p></div><div class="rounded-2xl bg-accent/10 border-r-4 border-accent p-6 mb-8"><h3 class="font-black text-primary text-lg mb-2">משפט שאפשר לומר</h3><p class="text-primary font-body leading-relaxed font-bold" data-result-phrase></p></div><div class="flex flex-col sm:flex-row gap-3"><a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-6 py-4 rounded-2xl gradient-gold text-primary font-bold shadow-gold" data-whatsapp-link>רוצה לבדוק את זה יחד? <span aria-hidden="true" class="mr-2">←</span></a><button type="button" class="px-6 py-4 rounded-2xl border border-primary/15 text-primary font-bold" data-restart>להתחיל שוב</button></div></section>
    </div>
    <aside class="mt-8 rounded-3xl bg-white border border-primary/10 p-7 text-right"><h2 class="text-xl font-black text-primary font-display mb-3">{tool.safetyTitle}</h2><p class="text-primary/75 font-body leading-relaxed">{tool.safetyText}</p></aside>
  </div></section>
</BaseLayout>
<script define:vars={{ results: tool.results, firstOptions: tool.firstOptions, secondOptions: tool.secondOptions, whatsAppPhone: site.whatsAppPhone }}>
  const root=document.querySelector('[data-parent-moment-tool]');if(root){const first=root.querySelector('[data-question="first"]'),second=root.querySelector('[data-question="second"]'),result=root.querySelector('[data-result]'),progress=root.querySelector('[data-progress]'),stepNumber=root.querySelector('[data-step-number]'),stepLabel=root.querySelector('[data-step-label]'),whatsappLink=root.querySelector('[data-whatsapp-link]');let selectedMoment='';const showFirst=()=>{selectedMoment='';first.classList.remove('hidden');second.classList.add('hidden');result.classList.add('hidden');progress.style.width='50%';stepNumber.textContent='1';stepLabel.textContent='שלב 1 מתוך 2'};root.querySelectorAll('[data-first-option]').forEach(button=>button.addEventListener('click',()=>{selectedMoment=button.dataset.firstOption;first.classList.add('hidden');second.classList.remove('hidden');progress.style.width='100%';stepNumber.textContent='2';stepLabel.textContent='שלב 2 מתוך 2';second.querySelector('[data-second-option]').focus()}));root.querySelector('[data-back]').addEventListener('click',showFirst);root.querySelector('[data-restart]').addEventListener('click',showFirst);root.querySelectorAll('[data-second-option]').forEach(button=>button.addEventListener('click',()=>{const key=button.dataset.secondOption,chosen=results.find(item=>item.key===key),moment=firstOptions.find(item=>item.key===selectedMoment),response=secondOptions.find(item=>item.key===key);if(!chosen||!moment||!response)return;second.classList.add('hidden');result.classList.remove('hidden');root.querySelector('[data-result-title]').textContent=chosen.title;root.querySelector('[data-result-text]').textContent=chosen.text;root.querySelector('[data-result-step]').textContent=chosen.nextStep;root.querySelector('[data-result-phrase]').textContent=chosen.phrase;const message=`היי יוסי, השתמשתי במפת הרגע בבית. ברגע של "${moment.label}" זיהיתי שאני נוטה "${response.label}". אשמח להבין איך אפשר להגיב אחרת.`;whatsappLink.href=`https://wa.me/${whatsAppPhone}?text=${encodeURIComponent(message)}`;result.focus()}))}
</script>
