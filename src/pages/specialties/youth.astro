---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import SpecialtyDecisionCards from '../../components/SpecialtyDecisionCards.astro'
import site from '../../content/pages/site.json'
import { sanity } from '../../lib/sanity'
import { buildBreadcrumbListSchema } from '../../lib/breadcrumbs'
import { buildServiceSchema } from '../../lib/schema'
import { ARTICLES_QUERY } from '../../lib/sanityQueries'
import { buildWhatsAppHref } from '../../lib/whatsapp'

const SLUG = 'specialties/youth'
const ctaMessage = 'היי יוסי, הגעתי דרך עמוד הליווי לבני נוער. אני רוצה להבין מה עובר על המתבגר/ת שלי ואיך אפשר לעזור לו/לה להתמודד עם הסתגרות, חרדה, כעס או ירידה בביטחון העצמי.'
const ctaHref = buildWhatsAppHref(site.whatsAppPhone, ctaMessage)

const page = await sanity.fetch(
  `*[_type=="page" && slug.current == $slug][0]{
    title,
    excerpt,
    specialty{
      intro,
      practicalGuidance{
        label,
        title,
        intro,
        steps[]{
          _key,
          title,
          text
        },
        withoutTeen{
          title,
          text
        },
        safety{
          title,
          text
        },
        gettingStarted{
          title,
          text
        },
        professionalTrust{
          title,
          text
        }
      },
      faqTitle,
      faq[]{
        question, answer
      },
      stagesTitle,
      stages[]{
        key, title, text
      },
      closing
    },
    aiCitation,
    painTags,
    aiContext,
    seo{
      title,
      description,
      canonical,
      noindex,
      ogImage{
        alt,
        asset->{url}
      }
    }
  }`,
  { slug: SLUG }
)

const title = page?.seo?.title || page?.title || site.brand
const description = page?.seo?.description || page?.excerpt || ''
const canonical = page?.seo?.canonical || new URL(Astro.url.pathname, site.siteUrl).toString()
const noindex = page?.seo?.noindex || false
const ogImage = page?.seo?.ogImage?.asset?.url || undefined
const ogImageAlt = page?.seo?.ogImage?.alt || undefined

const h1 = page?.title || ''
const gold = page?.excerpt || ''
const intro = page?.specialty?.intro || ''
const practicalGuidance = page?.specialty?.practicalGuidance || {}
const guidanceLabel = practicalGuidance.label || 'מה קורה בתהליך עם בני נוער?'
const guidanceTitle = practicalGuidance.title || 'לא לוחצים לספר הכול. מתחילים ממה שמכביד עכשיו.'
const guidanceIntro = practicalGuidance.intro || 'לא כל מתבגר מגיע עם מילים למה שעובר עליו. לפעמים הוא מגיע כי קשה לו בבית הספר, עם חברים או בבית; לפעמים הוא פשוט מרגיש שמשהו לא מסתדר. מתחילים מרגע אמיתי מהחיים שלו, בלי למהר להגדיר אותו ובלי להפוך אותו לבעיה שצריך לתקן.'
const guidanceSteps = practicalGuidance.steps || [
  {
    title: 'נותנים שם למה שקורה',
    text: 'מסתכלים על רגע מסוים: הודעה שלא נענתה, מבחן, מפגש חברתי או ריב בבית. כך אפשר לדבר על החוויה בלי להישאר במילים כלליות כמו "הכול מעצבן".',
  },
  {
    title: 'מזהים מה מפעיל את הלחץ',
    text: 'בודקים מה מסתתר מתחת להסתגרות, לכעס או להימנעות — פחד מדחייה, לחץ להצליח, בושה או תחושה שאין מקום להיות מי שאני.',
  },
  {
    title: 'בוחרים צעד שאפשר לנסות',
    text: 'לא מכוונים לשינוי ענק. בונים פעולה קטנה שמתאימה למתבגר עצמו, ואז בודקים מה השתנה ומה עוד צריך.',
  },
]
const withoutTeen = practicalGuidance.withoutTeen || {
  title: 'ההורה נשאר חלק מהתמונה',
  text: 'הליווי הוא של המתבגר ובקצב שלו. ההורים מקבלים מקום להבין את התמונה בבית, אבל נשמרת לו פרטיות כדי שיוכל לדבר בחופשיות. אותה סיטואציה יכולה להיחוות אחרת אצל כל אחד בבית — ולכן חשוב לתת מקום לשתי נקודות המבט.',
}
const safety = practicalGuidance.safety || {
  title: 'מתי חשוב לפנות גם לעזרה טיפולית או רפואית?',
  text: 'כשיש חשש לפגיעה עצמית, מחשבות אובדניות, שימוש בחומרים, שינוי חד ומתמשך בתפקוד, באכילה או בשינה — פונים בהקדם לאיש או אשת מקצוע בתחום בריאות הנפש או לרופא/ת המשפחה. ליווי רגשי אינו תחליף למענה רפואי או נפשי כשנדרש כזה.',
}
const gettingStarted = practicalGuidance.gettingStarted || { title: 'מתחילים בשיחה שמבררת התאמה', text: 'אפשר לשלוח הודעה קצרה על מה שאתם רואים בבית. בודקים מה נכון להציע למתבגר, איך להציג לו את התהליך והאם נדרש מענה טיפולי אחר.' }
const professionalTrust = practicalGuidance.professionalTrust || { title: 'יוסי מדלסי — מאמן רגשי מוסמך', text: 'הליווי נעשה בגובה העיניים ובקצב של המתבגר, עם מקום לפרטיות, לבחירה ולשיתוף ההורים בתמונה הרחבה.' }
const faqTitle = page?.specialty?.faqTitle || 'שאלות ותשובות'
const faqs = page?.specialty?.faq || []
const closing = page?.specialty?.closing || ''
const stagesTitle = page?.specialty?.stagesTitle || 'מה קורה בפועל'
const stages = page?.specialty?.stages || []

const breadcrumbSchema = buildBreadcrumbListSchema({
  siteUrl: site.siteUrl,
  brandName: site.brand,
  crumbs: [
    { name: 'תחומי התמחות', item: `${site.siteUrl}/specialties` },
    { name: h1, item: canonical },
  ],
})

const allArticles = await sanity.fetch(ARTICLES_QUERY)
const categoryArticles = allArticles?.filter((a) => a.tags && (a.tags.includes('נוער') || a.tags.includes('מתבגרים'))) || []

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null

const serviceSchema = buildServiceSchema({
  siteUrl: site.siteUrl,
  name: h1 || title,
  url: canonical,
  description,
  serviceType: 'אימון רגשי לבני נוער ומתבגרים',
  audience: 'בני נוער ומתבגרים המתמודדים עם הסתגרות, לחץ חברתי, חרדה, כעס או ירידה בביטחון העצמי, והוריהם',
})

const serviceSchemaAeo = {
  ...serviceSchema,
  ...(page?.aiCitation ? { abstract: page.aiCitation } : {}),
  ...(page?.aiContext ? { disambiguatingDescription: page.aiContext } : {}),
  ...(page?.painTags?.length ? { keywords: page.painTags.join(', ') } : {}),
}
const schemaArray = [serviceSchemaAeo, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  schema={schemaArray}
>
  <section class="animate-fade-in py-24 bg-background min-h-screen">
    <div class="max-w-4xl mx-auto px-6">
      <Breadcrumbs withSchema={false} items={[{ name: 'תחומי התמחות', href: '/specialties' }, { name: 'נוער ומתבגרים' }]} />
      <header class="mb-10 text-center">
        {h1 && (
          <h1 class="text-5xl md:text-6xl font-black text-primary font-display mb-6">
            {h1}
          </h1>
        )}

        {gold && (
          <p class="text-xl text-accent font-body font-bold max-w-3xl mx-auto">
            {gold}
          </p>
        )}

      </header>

      <!-- בקצרה (AEO): לחישה + "מתאים לך אם" -->
      {(page?.aiCitation || (page?.painTags && page.painTags.length > 0)) && (
        <aside class="max-w-3xl mx-auto mb-14 bg-accent/10 border-r-4 border-accent rounded-2xl p-6 md:p-8 text-right">
          <p class="text-accent font-display font-black text-sm tracking-wide mb-3">בקצרה</p>
          {page?.aiCitation && (
            <p class="text-primary font-body font-semibold text-lg leading-relaxed">{page.aiCitation}</p>
          )}
          {page?.painTags && page.painTags.length > 0 && (
            <div class={page?.aiCitation ? 'mt-5 pt-5 border-t border-accent/20' : ''}>
              <p class="font-black text-primary font-body mb-3">מתאים לך אם:</p>
              <ul class="space-y-2">
                {page.painTags.map((t: string) => (
                  <li class="flex items-start gap-3 text-primary/80 font-body leading-relaxed">
                    <span class="text-accent font-black mt-0.5">✓</span>
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      )}

      {intro && (
        <p class="mb-12 text-lg text-primary/70 font-body leading-relaxed max-w-3xl mx-auto text-center">
          {intro}
        </p>
      )}

      <section class="mb-16 bg-white rounded-[2.5rem] p-8 md:p-12 shadow-elegant border border-primary/10">
        <div class="max-w-3xl mx-auto">
          <p class="text-accent font-display font-black text-sm tracking-wide mb-3">{guidanceLabel}</p>
          <h2 class="text-3xl font-black text-primary font-display mb-5">
            {guidanceTitle}
          </h2>
          <p class="text-primary/75 font-body leading-relaxed text-lg mb-8">
            {guidanceIntro}
          </p>
          <ol class="grid gap-5 md:grid-cols-3 list-none p-0 m-0">
            {guidanceSteps.map((step, index) => (
              <li class="rounded-2xl bg-background p-5 border border-primary/10">
                <span class="block text-accent font-black text-xl mb-2">{index + 1}</span>
                <h3 class="font-black text-primary text-lg mb-2">{step.title}</h3>
                <p class="text-primary/75 leading-relaxed">{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <SpecialtyDecisionCards gettingStarted={gettingStarted} fitNote={withoutTeen} safety={safety} professionalTrust={professionalTrust} />

      {stages.length > 0 && (
        <section class="mb-16">
          <h2 class="text-3xl font-black text-primary font-display text-center mb-10">{stagesTitle}</h2>
          <div class="grid gap-6 md:grid-cols-3">
            {stages.map((stage: any, index: number) => (
              <div class="bg-white rounded-2xl p-6 shadow-md border border-primary/10">
                <div class="text-accent font-black text-xl mb-2">{index + 1}. {stage.title}</div>
                <p class="text-primary/80 leading-relaxed">{stage.text}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {faqs.length > 0 && (
        <div class="bg-white p-10 md:p-16 rounded-[3rem] shadow-elegant border border-white mb-16">
          <h2 class="text-2xl font-black text-primary font-display mb-10 text-center">
            {faqTitle}
          </h2>

          <div class="space-y-4">
            {faqs.map((item) => (
              <details class="group border border-primary/10 rounded-2xl p-6 bg-background cursor-pointer">
                <summary class="flex justify-between items-center list-none font-black text-lg text-primary">
                  {item.question}
                  <span class="text-2xl text-accent transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-4 text-primary/80 leading-relaxed">{item.answer}</p>
              </details>
            ))}
          </div>

          {closing && (
            <div class="mt-10 text-primary/75 font-body leading-relaxed text-center font-bold">
              {closing}
            </div>
          )}

          <div class="mt-10 text-center">
            <a
              href={ctaHref}
              data-track-event="service_cta"
              data-track-label="youth"
              class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl gradient-gold text-primary font-bold shadow-gold"
            >
              אני רוצה להבין מה עובר על המתבגר/ת שלי <span aria-hidden="true">←</span>
            </a>
          </div>
        </div>
      )}

      <div class="pt-8 border-t border-accent/10">
        <h2 class="text-3xl font-black text-primary font-display mb-6 text-center">
          מאמרים ומדריכים
        </h2>
        
        {categoryArticles.length === 0 ? (
          <div class="text-center bg-white rounded-3xl p-10 border border-white/50 shadow-sm">
            <p class="text-primary/60 font-body text-lg">
              מאמרים מקצועיים יעלו לכאן בקרוב.
            </p>
          </div>
        ) : (
          <div class="grid gap-8 md:grid-cols-2 mt-10">
            {categoryArticles.map((a) => (
              <a
                href={`/articles/${a.slug?.current}`}
                class="bg-white rounded-3xl shadow-lg hover:shadow-xl transition-all duration-300 border border-white/50 flex flex-col h-full overflow-hidden hover:-translate-y-2 group"
              >
                <div class="h-48 overflow-hidden relative w-full">
                  <img
                    src={a.mainImage?.asset?.url || ''}
                    alt={a.mainImage?.alt || a.title}
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="p-8 flex-1 flex flex-col items-start w-full">
                  <h3 class="text-xl font-black text-primary mb-3 font-display leading-tight group-hover:text-gold-dark transition-colors">
                    {a.title}
                  </h3>
                  <div class="mt-auto text-accent font-bold text-sm flex items-center group-hover:gap-2 transition-all">
                    קרא עוד <span class="mr-2">←</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
