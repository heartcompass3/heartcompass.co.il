---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import InsightsSearch from '../../components/InsightsSearch.astro'
import InsightArticleCard from '../../components/InsightArticleCard.astro'
import domains from '../../content/insights-domains.json'
import fallbackTaxonomy from '../../content/insights-taxonomy.json'
import site from '../../content/pages/site.json'
import {sanity} from '../../lib/sanity'
import {ARTICLES_QUERY} from '../../lib/sanityQueries'
import {effectiveTaxonomy} from '../../lib/insights.mjs'
import {searchArticles} from '../../lib/insights-search.mjs'
const query = (Astro.url.searchParams.get('q') || '').trim().slice(0,180)
const domain = domains.find(d=>d.id===Astro.url.searchParams.get('domain'))
const articles = query ? await sanity.fetch(ARTICLES_QUERY) : []
const taxonomy = effectiveTaxonomy(articles,fallbackTaxonomy)
const results = searchArticles(articles,taxonomy,query,domain?.id || '',articles.length)
Astro.response.headers.set('Cache-Control','private, no-store')
---
<BaseLayout title={`חיפוש במאמרי מצפן הלב | ${site.brand}`} description="חיפוש לפי נושאים, קשיים ושאלות במאמרי מצפן הלב." canonical={new URL('/insights/search',site.siteUrl).toString()} noindex={true}>
  <section class="py-12 md:py-20 bg-background"><div class="max-w-6xl mx-auto px-6">
    <Breadcrumbs items={[{name:'מרכז המידע',href:'/insights'},{name:'חיפוש במאמרים'}]} />
    <h1 class="font-display text-3xl md:text-5xl font-bold text-primary mb-6">חיפוש במאמרי מצפן הלב</h1>
    <InsightsSearch query={query} domain={domain?.id} />
    {query && <p class="text-xl text-primary mb-6" role="status">{results.length} מאמרים נמצאו לחיפוש „{query}”{domain ? ` בספרייה: ${domain.name}` : ' בכל הספריות'}.</p>}
    {results.length > 0 && <h2 class="sr-only">מאמרים שמתאימים לחיפוש</h2>}
    {results.length > 0 && <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{results.map(({article,placement})=><InsightArticleCard article={article} audience={domains.find(d=>d.id===placement?.domain)?.name || (placement?.domain==='legacy' ? 'מאמרים על עסקים ושיווק' : 'מאמרים נוספים')} />)}</div>}
    {query && !results.length && <div class="bg-white rounded-2xl p-6 text-primary"><h2 class="text-xl font-bold mb-3">אפשר לנסות ניסוח אחר</h2><p>נסו מילה מרכזית כמו חרדה, גבולות, זוגיות או מסכים, או הרחיבו את החיפוש לכל הספריות.</p></div>}
    <nav class="mt-10 flex flex-wrap gap-5" aria-label="לספריות המאמרים">{domains.map(d=><a href={`/insights/${d.id}`} class="underline font-bold text-primary">{d.name}</a>)}</nav>
  </div></section>
</BaseLayout>
