---
import site from '../content/pages/site.json'
import '../styles/global.css'
import { getAreaServed, getCoachingTopics, getProfessionalCredentials } from '../lib/schema'
import { sanity } from '../lib/sanity'
import { SITE_SETTINGS_QUERY } from '../lib/sanityQueries'

import SeoHead from '../components/SeoHead.astro'

import Navigation from '../components/Navigation.astro'
import Footer from '../components/Footer.astro'
import EnglishSiteFooter from '../components/EnglishSiteFooter.astro'
import WhatsAppFloat from '../components/WhatsAppFloat.astro'
import Tracking from '../components/Tracking.astro'
import CookieBanner from '../components/CookieBanner.astro'
import AccessibilityWidget from '../components/AccessibilityWidget.astro'
import ExitIntentWhatsApp from '../components/ExitIntentWhatsApp.astro'
import BackToTop from '../components/BackToTop.astro'

const {
  title,
  language = "he",
  languageLinks = [],
  description,
  canonical,
  // תאימות לאחור: חלק מהעמודים מעבירים noindex (ישן) וחלק noIndex (חדש)
  noindex,
  noIndex,
  ogImage,
  ogImageAlt,
  pageType,
  schema,
  // preload אופציונלי לתמונת ה-LCP (הירו): { srcset, sizes } או { href }
  preload,
  // og:type="article" בלבד — article:published_time / modified_time / author
  publishedTime,
  modifiedTime,
  // Pages that already fetched settings (currently /contact) can pass them in
  // so the layout does not issue a second request.
  siteSettings,
} = Astro.props

let resolvedSiteSettings = siteSettings ?? null
if (!resolvedSiteSettings) {
  try {
    resolvedSiteSettings = await sanity.fetch(SITE_SETTINGS_QUERY)
  } catch {
    resolvedSiteSettings = null
  }
}

const isEn = language === 'en'
const clean = (v?: string) => (typeof v === 'string' ? v.trim() : '')

const resolvedCanonicalRaw =
  clean(canonical) || new URL(Astro.url.pathname, site.siteUrl).toString()

// normalize canonical to match trailingSlash: 'never'
const normalizeCanonical = (url: string) => {
  const u = clean(url)
  if (!u) return u

  try {
    const parsed = new URL(u)
    const path = parsed.pathname || '/'
    const looksLikeFile = /\.[a-z0-9]+$/i.test(path)

    // home stays /
    if (path === '/') {
      parsed.pathname = '/'
      return parsed.toString()
    }

    // files keep as-is
    if (looksLikeFile) {
      return parsed.toString()
    }

    // remove trailing slash for all other paths
    parsed.pathname = path.replace(/\/$/, '')
    return parsed.toString()
  } catch {
    return u
  }
}

const resolvedCanonical = normalizeCanonical(resolvedCanonicalRaw)

const defaultDescription = isEn
  ? 'Emotional coaching with Yossi Medalsi and the M.S.A. approach: work on recurring patterns and barriers, and build direction, goals, and the ability to act.'
  : site.heroDescription || 'מצפן הלב הוא תהליך ברור, רגיש ומדויק שעוזר לך לבחור מתוך תשוקה ולא מתוך הפחד.'

const resolvedDescription = clean(description) || defaultDescription

const resolvedNoIndex = noIndex === true || noindex === true

const schemaArray = Array.isArray(schema) ? schema : []

// Detect article pages reliably
const hasArticleSchema = schemaArray.some(
  (s) => s && (s['@type'] === 'Article' || s['@type'] === 'NewsArticle')
)

const isArticlePage =
  pageType === 'article' ||
  Astro.url.pathname.startsWith('/articles/') ||
  hasArticleSchema

// WebSite schema — אומר לגוגל את שם האתר (במקום "Vercel").
// כשנעבור לדומיין משלנו: לעדכן רק את siteUrl ב-site.json — הכל מתעדכן אוטומטית.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.siteUrl}/#website`,
  name: site.brand,
  alternateName: ['Heart Compass', site.siteName, site.fullName],
  url: site.siteUrl,
  inLanguage: ['he', 'en'],
  // עקביות עם Article.publisher: הישות שמפרסמת את האתר היא העסק, לא האדם —
  // האדם הוא founder/author, לא publisher.
  publisher: { '@id': `${site.siteUrl}/#business` },
}

// כתובת בסיס — נתניה (העסק מתנהל אונליין; כשתיפתח קליניקה נעדכן כאן בלבד).
const businessAddress = {
  '@type': 'PostalAddress',
  addressLocality: isEn ? 'Netanya' : 'נתניה',
  addressRegion: isEn ? 'Central District' : 'מחוז המרכז',
  addressCountry: 'IL',
}

// ProfessionalService הוא תת-סוג של LocalBusiness — מספיק כדי לקבל "כרטיס מקומי".
// @id יציב (לא תלוי-עמוד) כדי שכל האתר יצביע לאותה ישות עסקית אחת.
const defaultServiceSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${site.siteUrl}/#business`,
  name: isEn ? 'Heart Compass' : site.brand,
  alternateName: isEn ? site.brand : 'Heart Compass',
  url: site.siteUrl,
  description: resolvedDescription,
  founder: { '@id': `${site.siteUrl}/#person` },
  address: businessAddress,
  areaServed: getAreaServed(language),
  priceRange: '₪₪',
  slogan: isEn ? 'Choose from passion, not from fear.' : site.tagline,
  email: site.email,
  telephone: `+${site.whatsAppPhone}`,
  image: `${site.siteUrl}/assets/og-image.jpg`,
  logo: `${site.siteUrl}/assets/logo.png`,
  // הפרופיל העסקי בגוגל — kgmid הוא מזהה הישות הקבוע ב-Knowledge Graph.
  hasMap: 'https://www.google.com/maps?kgmid=/g/11n457hlws',
  // רישומי ספריות עסקיות מאומתים — מאחדים את כל האזכורים לישות אחת בגוגל.
  sameAs: [
    // פייסבוק = עמוד המותג הייעודי (matzpenhalev). אינסטגרם = החשבון הפעיל
    // yossimedalsi שמשרת כרגע גם את המותג; @matzpenhalev שמור אך עדיין לא פעיל.
    'https://www.instagram.com/yossimedalsi/',
    'https://www.facebook.com/matzpenhalev',
    site.youtubeUrl,
    site.tiktokUrl,
    'https://www.google.com/maps?kgmid=/g/11n457hlws',
    'https://www.b144.co.il/מצפן-הלב/נתניה/',
    'https://easy.co.il/page/10158019',
    'https://lee.co.il/b/tQxW9',
    // הוסר קישור Wikidata שגוי (Q140424600 / Q140424390) — אומת מול ה-API הרשמי
    // ולא קיים שום פריט כזה. אין כרגע פריט Wikidata אמיתי לעסק או למייסד.
  ],
  knowsAbout: getCoachingTopics(language),
}

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.siteUrl}/#person`,
  name: isEn ? 'Yossi Medalsi' : site.fullName,
  alternateName: isEn ? site.fullName : 'Yossi Medalsi',
  // עמוד הפרופיל הקנוני של האדם — לא דף הבית (זה של העסק). עקבי עם /about
  // ועם article.author.url בעמוד המאמר.
  url: `${site.siteUrl}${isEn ? '/en/about' : '/about'}`,
  jobTitle: isEn ? 'Emotional coach' : 'מאמן רגשי',
  email: site.email,
  address: businessAddress,
  worksFor: { '@id': `${site.siteUrl}/#business` },
  // הסמכות = אות E-E-A-T מרכזי בגוגל.
  hasCredential: getProfessionalCredentials(site.siteUrl, language),
  knowsAbout: getCoachingTopics(language),
  sameAs: [
    site.instagramUrl,
    site.facebookUrl,
    'https://www.linkedin.com/in/yossi-medalsi/',
    `https://wa.me/${site.whatsAppPhone}`,
    'https://www.alternabe.co.il/therapist/yossi-madlsi-emotional-coaching',
  ],
  image: `${site.siteUrl}/assets/og-image.jpg`,
}

// Do not inject ProfessionalService on article pages.
// Also: if page already provides its own service schema, do not duplicate.
const alreadyHasService = schemaArray.some(
  (s) => s && (s['@type'] === 'ProfessionalService' || s['@type'] === 'Organization' || s['@type'] === 'LocalBusiness' || (Array.isArray(s['@type']) && s['@type'].includes('Organization')))
)

// אם העמוד מספק Person משלו (למשל דף "אודות" עם ביוגרפיה) — לא מזריקים את הגנרי.
const alreadyHasPerson = schemaArray.some((s) => s && s['@type'] === 'Person')

// Give every page a language-bearing WebPage entity, including policy pages.
const pageTypes = ['WebPage', 'ProfilePage', 'AboutPage', 'ContactPage', 'CollectionPage']
const hasWebPage = schemaArray.some((item) => pageTypes.includes(item?.['@type']))
const defaultWebPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${resolvedCanonical}#webpage`,
  url: resolvedCanonical,
  name: clean(title) || (isEn ? 'Heart Compass' : site.brand),
  description: resolvedDescription,
  inLanguage: language,
  isPartOf: { '@id': `${site.siteUrl}/#website` },
}

// WebSite נכנס לכל עמוד (כולל מאמרים) — פעם אחת בלבד.
let mergedSchema
if (isArticlePage) {
  mergedSchema = [websiteSchema, ...schemaArray]
} else {
  const injected = [websiteSchema]
  if (!alreadyHasService) injected.push(defaultServiceSchema)
  if (!alreadyHasPerson) injected.push(personSchema)
  mergedSchema = [...injected, ...schemaArray]
}
if (!hasWebPage) mergedSchema.push(defaultWebPageSchema)
mergedSchema = mergedSchema.map((item) =>
  pageTypes.includes(item?.['@type']) || item?.['@type'] === 'FAQPage'
    ? { ...item, inLanguage: language, isPartOf: { '@id': `${site.siteUrl}/#website` } }
    : item
)
---

<!doctype html>
<html lang={language} dir={language === "en" ? "ltr" : "rtl"} class="bg-background text-foreground">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* preload לתמונת ה-LCP — מאיץ את ה-Largest Contentful Paint */}
    {preload?.srcset && (
      <link
        rel="preload"
        as="image"
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes}
        fetchpriority="high"
      />
    )}
    {preload?.href && !preload?.srcset && (
      <link rel="preload" as="image" href={preload.href} fetchpriority="high" />
    )}

    <!-- Google Search Console verification -->
    <meta
      name="google-site-verification"
      content="JnPSkMeCL51vUpC5HuP0QtTUnyHdGn6qpMpo9ZwKCrw"
    />

    <!-- Pinterest domain claim -->
    <meta name="p:domain_verify" content="da6c46b9dcfdb18b2bcb8614ac498486" />

    <SeoHead
      title={title}
      language={language}
      languageLinks={languageLinks}
      description={resolvedDescription}
      canonical={resolvedCanonical}
      noIndex={resolvedNoIndex}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      pageType={pageType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      schema={mergedSchema}
    />

    <link rel="describedby" href="/llms.txt" type="text/plain" />
    <link rel="icon" href="/assets/logo.png" />

    <!-- Tracking Layer -->
    <Tracking />

    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="dns-prefetch" href="//wa.me" />
    <link rel="dns-prefetch" href="//api.whatsapp.com" />
    <!-- self-hosted variable fonts: preload קובץ אחד לכל משפחה (כל המשקלים) -->
    <link rel="preload" href="/fonts/Heebo-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Assistant-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body class="min-h-screen selection:bg-accent selection:text-primary">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:right-3 focus:z-[1001] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg"
    >
      {language === "en" ? "Skip to main content" : "דלג לתוכן הראשי"}
    </a>
    <div lang={language} dir={language === 'en' ? 'ltr' : 'rtl'}><Navigation settings={resolvedSiteSettings} language={language} /></div>
    <main id="main-content">
      <slot />
    </main>
    {language === 'en' ? <EnglishSiteFooter /> : <div lang="he" dir="rtl"><Footer settings={resolvedSiteSettings} /></div>}
    <WhatsAppFloat settings={resolvedSiteSettings} language={language} />
    <BackToTop language={language} />
    <CookieBanner language={language} />
    <AccessibilityWidget language={language} />
    <ExitIntentWhatsApp language={language} />
  </body>
</html>
