---
type Card = { title?: string; text?: string }

const {
  gettingStarted = {},
  fitNote = {},
  safety = {},
  professionalTrust = {},
} = Astro.props as {
  gettingStarted?: Card
  fitNote?: Card
  safety?: Card
  professionalTrust?: Card
}
---

<section class="mb-16" aria-labelledby="before-first-meeting">
  <div class="mx-auto mb-8 max-w-3xl text-center">
    <p class="mb-3 text-sm font-black tracking-wide text-accent">לפני הפגישה הראשונה</p>
    <h2 id="before-first-meeting" class="font-display text-3xl font-black text-primary">הדברים שכדאי לדעת לפני שמחליטים להתחיל</h2>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border-r-4 border-accent bg-accent/10 p-7">
    <h2 class="font-display text-2xl font-black text-primary">{gettingStarted.title}</h2>
    <p class="mt-4 font-body leading-relaxed text-primary/80">{gettingStarted.text}</p>
  </div>

  <div class="rounded-3xl border border-primary/10 bg-white p-7 shadow-sm">
    <h2 class="font-display text-2xl font-black text-primary">{fitNote.title}</h2>
    <p class="mt-4 font-body leading-relaxed text-primary/80">{fitNote.text}</p>
  </div>

  <div class="rounded-3xl border border-primary/10 bg-white p-7 shadow-sm">
    <h2 class="font-display text-2xl font-black text-primary">{professionalTrust.title}</h2>
    <p class="mt-4 font-body leading-relaxed text-primary/80">{professionalTrust.text}</p>
    <a href="/about" class="mt-4 inline-block font-bold text-accent underline underline-offset-4">להכיר את יוסי ואת ההכשרות</a>
    </div>
  </div>
</section>

<section class="mb-16 rounded-3xl border border-primary/10 bg-white p-7 shadow-sm">
  <h2 class="font-display text-2xl font-black text-primary">{safety.title}</h2>
  <p class="mt-4 font-body leading-relaxed text-primary/80">{safety.text}</p>
</section>
