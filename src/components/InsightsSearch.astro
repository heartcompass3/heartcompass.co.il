---
import domains from '../content/insights-domains.json'
const {domain='',query='',language='he'} = Astro.props
const en = language === 'en'
const t = (he: string, english: string) => en ? english : he
---
<form action={en ? "/en/insights/search" : "/insights/search"} method="get" role="search" aria-label={t("חיפוש במאמרי מצפן הלב", "Search Heart Compass articles")} class="bg-white border border-primary/15 rounded-2xl p-5 md:p-6 mb-10">
  <label for="insights-query" class="block text-xl font-display font-bold text-primary mb-2">{t("מה מעסיק אותך?", "What is on your mind?")}</label>
  <p id="search-help" class="text-primary/75 mb-4">{t("חפשו נושא, קושי או שאלה, למשל חרדה, שחרור דפוסים או קשה לי להגיד לא.", "Search the English articles by topic or question, for example recurring patterns.")}</p>
  <div class="flex flex-col md:flex-row gap-3">
    <input id="insights-query" name="q" type="search" value={query} maxlength="180" required aria-describedby="search-help" placeholder={t("נושא, קושי או שאלה", "Topic, difficulty or question")} class="border border-primary/30 rounded-xl px-4 py-3 min-w-0 flex-1 text-primary bg-white" />
    {!en && <label class="sr-only" for="insights-audience">באיזו ספרייה לחפש?</label>}
    {en ? <input type="hidden" name="domain" value="personal" /> : <select id="insights-audience" name="domain" class="border border-primary/30 rounded-xl px-3 py-3 text-primary bg-white max-w-full">
      <option value="" selected={!domain}>בכל הספריות</option>
      {domains.map(d=><option value={d.id} selected={domain===d.id}>{d.name}</option>)}
    </select>}
    <button type="submit" class="rounded-xl px-7 py-3 bg-primary text-white font-bold">{t("חיפוש", "Search")}</button>
  </div>
</form>
