---
export interface TestimonialItem {
  text: string
  context?: string
  time?: string
  role?: string
}

interface Props {
  title?: string
  subtitle?: string
  disclaimer?: string
  items: TestimonialItem[]
}

const {
  title = 'רגעים של שינוי מהשטח',
  subtitle = 'איך נראית היציאה מתקיעות לעצמאות בחיים האמיתיים',
  disclaimer = 'הודעות אותנטיות מתוך ליוויים אישיים, בעילום שם מלא לשמירה על סודיות',
  items = [],
} = Astro.props
---

{items.length > 0 && (
  <section class="mb-16" aria-labelledby="whatsapp-testimonials-title">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-800 text-xs md:text-sm font-bold mb-4 border border-emerald-500/20 shadow-sm">
        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>{disclaimer}</span>
      </div>
      <h2 id="whatsapp-testimonials-title" class="font-display text-3xl md:text-4xl font-black text-primary mb-3">
        {title}
      </h2>
      {subtitle && (
        <p class="font-body text-lg text-primary/75 max-w-2xl mx-auto leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>

    <div class="grid gap-6 md:grid-cols-2 max-w-4xl mx-auto">
      {items.map((item) => (
        <article class="relative flex flex-col justify-between rounded-3xl p-6 md:p-7 bg-[#E7FEE4]/80 dark:bg-emerald-950/30 border border-emerald-600/20 shadow-sm hover:shadow-md transition-shadow">
          <div>
            {item.context && (
              <div class="flex items-center justify-between mb-4 border-b border-emerald-700/10 pb-2.5">
                <span class="text-xs font-black tracking-wide text-emerald-900 bg-white/80 dark:bg-emerald-900/60 px-3 py-1 rounded-full border border-emerald-600/10">
                  {item.context}
                </span>
                <span class="text-[11px] text-emerald-900/60 font-mono">
                  {item.time || 'הודעה מוקלטת/נכנסת'}
                </span>
              </div>
            )}
            <p class="font-body text-primary/90 text-base md:text-lg leading-relaxed whitespace-pre-line">
              "{item.text}"
            </p>
          </div>
          <div class="mt-5 pt-3 flex items-center justify-between text-emerald-800/70 text-xs border-t border-emerald-700/10">
            <span class="font-medium">{item.role || 'מתוך וואטסאפ'}</span>
            <div class="flex items-center gap-1 text-emerald-600">
              <span class="text-[11px] font-mono">נקרא</span>
              <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="m9.5 12.75 3.5 3.5 6.5-9.75"/>
              </svg>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
)}
