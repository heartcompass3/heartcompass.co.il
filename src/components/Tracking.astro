---
import { sanity } from '../lib/sanity'

type TrackingSettings = {
  enabled?: boolean
  gaMeasurementId?: string
  metaPixelId?: string
  tiktokPixelId?: string
}

// הגדרות הטראקינג מגיעות מסאניטי (הגדרות אתר → Tracking).
// משתני הסביבה משמשים כגיבוי אם סאניטי לא זמין או שהשדות ריקים.
// cache קצר כדי לא לשלוף מסאניטי בכל צפייה בעמוד.
const CACHE_TTL_MS = 5 * 60 * 1000
const g = globalThis as typeof globalThis & {
  __trackingCache?: { value: TrackingSettings | null; fetchedAt: number }
}

let tracking: TrackingSettings | null = null
if (g.__trackingCache && Date.now() - g.__trackingCache.fetchedAt < CACHE_TTL_MS) {
  tracking = g.__trackingCache.value
} else {
  try {
    tracking = await sanity.fetch<TrackingSettings | null>(
      `*[_type == "siteSettings"][0].tracking`
    )
  } catch {
    tracking = null
  }
  g.__trackingCache = { value: tracking, fetchedAt: Date.now() }
}

const clean = (v?: unknown) => (typeof v === 'string' ? v.trim() : '')

const envEnabled =
  (import.meta.env.PUBLIC_TRACKING_ENABLED ?? '').toString().toLowerCase() === 'true'
const enabled = tracking?.enabled === true || envEnabled

const gaId = clean(tracking?.gaMeasurementId) || clean(import.meta.env.PUBLIC_GA_ID)
const gtmId = clean(import.meta.env.PUBLIC_GTM_ID)
const metaPixelId = clean(tracking?.metaPixelId) || clean(import.meta.env.PUBLIC_META_PIXEL_ID)

// בונים את הסקריפטים בצד שרת (אינטרפולציה אמיתית של המזהים),
// ומזריקים עם set:html. כך נמנעים מבעיית האינטרפולציה של is:inline.
const gtmSnippet = gtmId
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`
  : ''

// GA: טוענים את gtag.js דינמית מתוך הפונקציה הנדחית, כדי שלא ייטען לפני הסכמה.
const gaSnippet = gaId
  ? `var _hcGa=document.createElement('script');_hcGa.async=true;_hcGa.src='https://www.googletagmanager.com/gtag/js?id=${gaId}';document.head.appendChild(_hcGa);window.dataLayer=window.dataLayer||[];window.gtag=window.gtag||function(){dataLayer.push(arguments);};gtag('js',new Date());gtag('config','${gaId}',{anonymize_ip:true});`
  : ''

const metaSnippet = metaPixelId
  ? `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${metaPixelId}');fbq('track','PageView');`
  : ''

// כל סקריפטי המדידה נדחים עד לקבלת הסכמה מפורשת בבאנר העוגיות.
// זה מיישר את הקוד עם מדיניות הפרטיות: אנליטיקה ופרסום נטענים רק אחרי "אישור".
const consentGatedSnippet =
  gaId || gtmId || metaPixelId
    ? `(function(){
        var KEY='hc_cookie_consent';
        function loadTracking(){
          if(window.__hcTrackingLoaded)return;
          window.__hcTrackingLoaded=true;
          ${gtmSnippet}
          ${gaSnippet}
          ${metaSnippet}
        }
        function check(){
          if(localStorage.getItem(KEY)==='accepted'){loadTracking();return true;}
          return false;
        }
        if(!check()){
          window.addEventListener('hc:consent-changed',check);
        }
      })();`
    : ''
---

{enabled && consentGatedSnippet ? (
  <script is:inline set:html={consentGatedSnippet}></script>
) : null}
