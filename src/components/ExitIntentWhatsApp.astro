---
import site from '../content/pages/site.json'

// Show only after 90 seconds of visible reading and 40% scroll; desktop also requires exit intent.
// מטרה: לתפוס שאלה פתוחה לפני יציאה, בלי מודאל שמכסה מסך (בלי עונש interstitial).
const { language = 'he' } = Astro.props
const isEn = language === 'en'
const t = (en: string, he: string) => isEn ? en : he
const waMessage = t('Hi Yossi, I have been reading the Heart Compass website and would like to share what is happening in my life.', 'היי יוסי, קראתי באתר ואני רוצה לשתף בקצרה במה שקורה.')
const waHref = `https://wa.me/${site.whatsAppPhone}?text=${encodeURIComponent(waMessage)}`
---

<div
  class="hc-exit hidden"
  lang={language}
  dir={isEn ? 'ltr' : 'rtl'}
  data-exit-root
  role="dialog"
  aria-labelledby="hc-exit-title"
  aria-describedby="hc-exit-body"
>
  <div class="hc-exit-toolbar">
    <button type="button" class="hc-exit-close" aria-label={t('Close contact invitation', 'סגירת חלונית יצירת קשר')} data-exit-close>
      <span aria-hidden="true">&times;</span> {t('Close', 'סגירה')}
    </button>
  </div>

  <div class="hc-exit-head">
    <img data-src="/assets/yossi-profile.jpg" alt={t('Yossi Medalsi', 'יוסי מדלסי')} class="hc-exit-avatar" width="48" height="48" />
    <div>
      <div class="hc-exit-name">{t('Yossi Medalsi', 'יוסי מדלסי')}</div>
      <div class="hc-exit-role">{t('Emotional coach · Heart Compass', 'מאמן רגשי · מצפן הלב')}</div>
    </div>
  </div>

  <div id="hc-exit-title" class="hc-exit-title">{t('Is there something you would like to ask?', 'יש משהו שתרצו לשאול?')}</div>
  <p id="hc-exit-body" class="hc-exit-body">
    {t('If something resonated while you were reading, you can message me on WhatsApp and briefly share what is happening.', 'אם משהו נגע בך תוך כדי הקריאה, אפשר לכתוב לי בוואטסאפ ולספר בקצרה מה קורה.')}
  </p>

  <a
    href={waHref}
    target="_blank"
    rel="noopener noreferrer"
    class="hc-exit-cta"
    data-exit-cta
  >
    <svg viewBox="0 0 32 32" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M16 3C9.4 3 4 8.3 4 14.8c0 2.2.6 4.2 1.8 6L4 29l8.4-1.8c1.1.3 2.3.5 3.6.5 6.6 0 12-5.3 12-11.9S22.6 3 16 3Zm0 21.6c-1.2 0-2.3-.2-3.3-.6l-.6-.2-5 1.1 1.1-4.8-.3-.6c-1-1.6-1.6-3.4-1.6-5.4C6.3 9.3 10.7 5 16 5s9.7 4.3 9.7 9.6-4.4 10-9.7 10Z"/>
      <path d="M22.1 18.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2-.2.3-.8.9-1 .9-.2.1-.4.1-.7-.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6-.1-.1-.7-1.7-1-2.3-.3-.6-.6-.5-.8-.5h-.7c-.2 0-.5.1-.7.4-.2.3-1 1-1 2.4 0 1.4 1 2.7 1.1 2.9.1.2 2 3 4.9 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4 0-.1-.3-.2-.6-.3Z"/>
    </svg>
    {t('Message Yossi', 'לכתוב ליוסי')}
  </a>
</div>

<style>
  .hc-exit {
    position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%) translateY(12px);
    width: min(340px, calc(100vw - 2rem)); z-index: 200;
    background: #fff; border: 1px solid rgba(15,44,54,.12); border-radius: 18px;
    box-shadow: 0 16px 40px rgba(0,0,0,.18); padding: 18px 18px 20px;
    font-family: 'Assistant', sans-serif; text-align: start;
    opacity: 0; transition: opacity .28s ease, transform .28s ease;
    max-height: calc(100vh - 6rem); max-height: calc(100dvh - 6rem); overflow-y: auto;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
  }
  .hc-exit.hc-show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .hc-exit.hidden { display: none; }

  .hc-exit-toolbar {
    display: flex; justify-content: flex-start; position: sticky; top: 0; z-index: 1;
    background: #fff; margin-bottom: 8px;
  }
  .hc-exit-close {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    min-width: 80px; min-height: 44px; padding: 8px 12px;
    background: #f4f6f6; border: 1px solid rgba(15,44,54,.15); border-radius: 8px;
    font: inherit; font-size: 1rem; line-height: 1.2; color: #0f2c36; cursor: pointer;
  }
  .hc-exit-close span { font-size: 1.4em; line-height: 1; }
  .hc-exit-close:hover { color: #0f2c36; }
  .hc-exit-close:focus-visible { outline: 2px solid #D4AF37; outline-offset: 2px; border-radius: 4px; }

  .hc-exit-head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .hc-exit-avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid #D4AF37; }
  .hc-exit-name { font-weight: 800; color: #0f2c36; font-size: .98rem; }
  .hc-exit-role { font-size: .8rem; color: #5a6a6f; }

  .hc-exit-title { font-weight: 800; color: #0f2c36; font-size: 1.05rem; margin-bottom: 6px; }
  .hc-exit-body { font-size: .9rem; color: #40525a; line-height: 1.6; margin: 0 0 14px; }

  .hc-exit-cta {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    background: #25D366; color: #fff; font-weight: 800; font-size: 1rem;
    padding: 12px; border-radius: 12px; text-decoration: none;
  }
  .hc-exit-cta:hover { filter: brightness(.96); }
  .hc-exit-cta:focus-visible { outline: 3px solid #0f2c36; outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .hc-exit { transition: none; }
  }
</style>

<script is:inline>
  (() => {
    const KEY = 'hc_exit_wa';
    const CONSENT_KEY = 'hc_cookie_consent';
    const CAP_DAYS = 14;
    const MIN_READING_MS = 90000;
    const MIN_SCROLL = 0.4;
    const root = document.querySelector('[data-exit-root]');
    if (!root) return;

    const recentlySeen = () => {
      try { if (sessionStorage.getItem(KEY)) return true; } catch {}
      try {
        const seen = Number(localStorage.getItem(KEY) || 0);
        return seen > 0 && Date.now() - seen < CAP_DAYS * 864e5;
      } catch { return false; }
    };
    if (recentlySeen()) return;

    let shown = false;
    let activeReadingMs = 0;
    let lastTick = Date.now();
    let maxScroll = 0;
    let timer = null;
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    const markSeen = () => {
      try { localStorage.setItem(KEY, String(Date.now())); } catch {}
      try { sessionStorage.setItem(KEY, 'seen'); } catch {}
    };
    const canShow = () => {
      if (shown || recentlySeen() || document.visibilityState !== 'visible') return false;
      if (activeReadingMs < MIN_READING_MS || maxScroll < MIN_SCROLL) return false;
      try {
        const c = localStorage.getItem(CONSENT_KEY);
        if (c !== 'accepted' && c !== 'declined') return false;
      } catch { return false; }
      if (document.activeElement?.matches('input, textarea, select, [contenteditable="true"]')) return false;
      return document.querySelector('[data-a11y-toggle]')?.getAttribute('aria-expanded') !== 'true'
        && document.querySelector('[data-wa-button]')?.getAttribute('aria-expanded') !== 'true';
    };
    const show = () => {
      if (!canShow()) return;
      shown = true;
      markSeen();
      const avatar = root.querySelector('.hc-exit-avatar');
      if (avatar && !avatar.getAttribute('src') && avatar.dataset.src) avatar.setAttribute('src', avatar.dataset.src);
      root.classList.remove('hidden');
      requestAnimationFrame(() => root.classList.add('hc-show'));
      cleanup();
    };
    const hide = () => {
      root.classList.remove('hc-show');
      setTimeout(() => root.classList.add('hidden'), 280);
    };
    const onScroll = () => {
      const distance = document.documentElement.scrollHeight - window.innerHeight;
      if (distance > 0) maxScroll = Math.max(maxScroll, window.scrollY / distance);
      if (isTouch) show();
    };
    const onMouseOut = (event) => {
      if (event.clientY <= 0 && !event.relatedTarget) show();
    };
    const onVisibilityChange = () => { lastTick = Date.now(); };
    const onManualWhatsApp = () => { markSeen(); hide(); cleanup(); };
    function cleanup() {
      if (timer !== null) clearInterval(timer);
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('mouseout', onMouseOut);
      document.removeEventListener('visibilitychange', onVisibilityChange);
    }

    root.querySelector('[data-exit-close]')?.addEventListener('click', hide);
    root.querySelector('[data-exit-cta]')?.addEventListener('click', hide);
    document.addEventListener('hc:a11y-open', hide);
    document.addEventListener('hc:whatsapp-open', onManualWhatsApp);
    document.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a[href*="wa.me/"], a[href*="api.whatsapp.com/"]')) onManualWhatsApp();
    });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') hide(); });
    document.addEventListener('visibilitychange', onVisibilityChange);
    window.addEventListener('scroll', onScroll, { passive: true });
    if (!isTouch) document.addEventListener('mouseout', onMouseOut);
    timer = setInterval(() => {
      const now = Date.now();
      if (document.visibilityState === 'visible') activeReadingMs += Math.min(now - lastTick, 2000);
      lastTick = now;
      if (isTouch) show();
    }, 1000);
    onScroll();
  })();
</script>
